rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/dashboard/{section} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid == 'M2vGiZkKpMYxjF8akAAnkm7OAK92'
        && section in ['cfpTodos','cfpChat','cfpEventFeedback','cfpShownEvents','cfpLocation']
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['value'])
          && request.resource.data.value is string
          && request.resource.data.value.size() < 1000000));
    }
  }
}
